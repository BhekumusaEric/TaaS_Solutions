# Local Development Environment Variables
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and will not be committed

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/taas_dev"

# NextAuth.js Configuration
# NEXTAUTH_URL: Base URL of your application (with protocol and port)
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET: Secret key for JWT signing and encryption
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Optional: For local development
NODE_ENV="development"
