# Database
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Example: postgresql://postgres:password@localhost:5432/taas_dev
DATABASE_URL="postgresql://postgres:password@localhost:5432/taas_dev"

# NextAuth.js Configuration
# NEXTAUTH_URL: The base URL of your application (include protocol and port for local dev)
# Local development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET: Secret key for signing and encrypting JWT tokens
# REQUIRED: Generate a secure random string using the command below
# Generate with: openssl rand -base64 32
# IMPORTANT: Use a different secret for each environment (dev, staging, production)
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Email (Future)
# EMAIL_FROM="noreply@taassolutions.com"
# EMAIL_API_KEY="your-email-api-key"

# File Storage (Future)
# STORAGE_BUCKET="taas-storage"
# STORAGE_ACCESS_KEY="your-storage-key"
